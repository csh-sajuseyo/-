# Copy to .env (git-ignored). The collector reads the key ONLY from this file.
ANTHROPIC_API_KEY=sk-ant-...
# Daily spend cap in USD for classification + briefings together (resets 00:00 KST)
NEWS_FEED_DAILY_USD_CAP=2.00
# Body summaries of important articles: own daily cap in USD (inside the cap above)
NEWS_FEED_SUMMARY_USD_CAP=0.10
# Optional overrides
# NEWS_FEED_MODEL=claude-haiku-5-5
# NEWS_FEED_BRIEF_MODEL=claude-sonnet-5-5
# NEWS_FEED_BRIEF_TIMES=08:20,21:50
# NEWS_FEED_INTERVAL_SEC=300
# bls.gov (US CPI / jobs release schedule) answers 403 to anonymous scripts. Put a contact e-mail here;
# it is sent only to bls.gov, in the User-Agent and From headers.
# NEWS_FEED_CONTACT=you@example.com
